<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_rename_root"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="26dp"
    android:paddingBottom="26dp"
    android:gravity="center_horizontal"
    android:defaultFocusHighlightEnabled="false">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Rinomina Ingresso"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_rename_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Personalizza etichetta e icona dell'ingresso HDMI"
        android:textColor="#A0FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOME DISPOSITIVO:"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_input_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/input_field_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#60FFFFFF"
        android:hint="es. Switch 2, Series X, PC"
        android:singleLine="true"
        android:maxLines="1"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:textSize="15sp"
        android:focusable="true"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SOTTOTITOLO / DETTAGLI:"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_input_subtitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/input_field_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#60FFFFFF"
        android:hint="es. HDMI 2 • Connesso"
        android:singleLine="true"
        android:maxLines="1"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:textSize="14sp"
        android:focusable="true"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false" />

    <!-- Icon Picker Row -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCEGLI ICONA:"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btn_icon_hdmi"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="🔌 HDMI"
            android:textColor="@color/choice_chip_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/choice_chip_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

        <TextView
            android:id="@+id/btn_icon_gamepad"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="🎮 Console"
            android:textColor="@color/choice_chip_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/choice_chip_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

        <TextView
            android:id="@+id/btn_icon_pc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="🖥️ PC"
            android:textColor="@color/choice_chip_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/choice_chip_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

        <TextView
            android:id="@+id/btn_icon_tv"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📺 TV"
            android:textColor="@color/choice_chip_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/choice_chip_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

    </LinearLayout>

    <!-- Save / Cancel Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_save_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="Salva Modifiche"
            android:textColor="@color/dialog_button_text_color"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

        <TextView
            android:id="@+id/btn_cancel_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Annulla"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="14sp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false" />

    </LinearLayout>

    <!-- Delete / Hide Input Button -->
    <TextView
        android:id="@+id/btn_delete_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="🗑️ Rimuovi questo Ingresso"
        android:textColor="#FFFF7777"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="@drawable/dialog_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false" />

</LinearLayout>
