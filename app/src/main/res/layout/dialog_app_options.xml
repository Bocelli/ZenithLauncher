<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_options_root"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="26dp"
    android:paddingBottom="26dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_options_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tv_options_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="22dp"
        android:textColor="#A0FFFFFF"
        android:textSize="13sp"
        android:text="Gestione Applicazione" />

    <!-- Button 1: Toggle Favorite -->
    <TextView
        android:id="@+id/btn_opt_favorite"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/dialog_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center"
        android:text="⭐ Aggiungi a Preferiti"
        android:textColor="@color/dialog_button_text_color"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Button 2: Toggle PIN Lock -->
    <TextView
        android:id="@+id/btn_opt_lock"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center"
        android:text="🔒 Blocca con PIN"
        android:textColor="@color/dialog_button_text_color"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Button 3: Change PIN -->
    <TextView
        android:id="@+id/btn_opt_change_pin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center"
        android:text="🔑 Modifica PIN Master"
        android:textColor="@color/dialog_button_text_color"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Button 4: Cancel -->
    <TextView
        android:id="@+id/btn_opt_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_button_selector"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center"
        android:text="Chiudi"
        android:textColor="@color/dialog_button_text_color"
        android:textSize="13sp" />

</LinearLayout>
