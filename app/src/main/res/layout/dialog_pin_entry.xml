<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_pin_root"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="26dp"
    android:paddingBottom="26dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:text="🔒 Inserisci PIN" />

    <TextView
        android:id="@+id/tv_pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#A0FFFFFF"
        android:textSize="13sp"
        android:text="Applicazione protetta" />

    <!-- 4 PIN Dots -->
    <TextView
        android:id="@+id/tv_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:text="○  ○  ○  ○" />

    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textColor="#FF4D4D"
        android:textSize="12sp"
        android:text="PIN non corretto, riprova"
        android:visibility="invisible" />

    <!-- Numpad Row 1: 1, 2, 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusRight="@+id/btn_key_2"
            android:nextFocusDown="@+id/btn_key_4" />

        <TextView
            android:id="@+id/btn_key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusLeft="@+id/btn_key_1"
            android:nextFocusRight="@+id/btn_key_3"
            android:nextFocusDown="@+id/btn_key_5" />

        <TextView
            android:id="@+id/btn_key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusLeft="@+id/btn_key_2"
            android:nextFocusDown="@+id/btn_key_6" />

    </LinearLayout>

    <!-- Numpad Row 2: 4, 5, 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_1"
            android:nextFocusRight="@+id/btn_key_5"
            android:nextFocusDown="@+id/btn_key_7" />

        <TextView
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_2"
            android:nextFocusLeft="@+id/btn_key_4"
            android:nextFocusRight="@+id/btn_key_6"
            android:nextFocusDown="@+id/btn_key_8" />

        <TextView
            android:id="@+id/btn_key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_3"
            android:nextFocusLeft="@+id/btn_key_5"
            android:nextFocusDown="@+id/btn_key_9" />

    </LinearLayout>

    <!-- Numpad Row 3: 7, 8, 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_4"
            android:nextFocusRight="@+id/btn_key_8"
            android:nextFocusDown="@+id/btn_key_cancel" />

        <TextView
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_5"
            android:nextFocusLeft="@+id/btn_key_7"
            android:nextFocusRight="@+id/btn_key_9"
            android:nextFocusDown="@+id/btn_key_0" />

        <TextView
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_6"
            android:nextFocusLeft="@+id/btn_key_8"
            android:nextFocusDown="@+id/btn_key_del" />

    </LinearLayout>

    <!-- Numpad Row 4: Cancel, 0, Del -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_7"
            android:nextFocusRight="@+id/btn_key_0" />

        <TextView
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_8"
            android:nextFocusLeft="@+id/btn_key_cancel"
            android:nextFocusRight="@+id/btn_key_del" />

        <TextView
            android:id="@+id/btn_key_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/dialog_button_selector"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⌫"
            android:textColor="@color/dialog_button_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_9"
            android:nextFocusLeft="@+id/btn_key_0" />

    </LinearLayout>

</LinearLayout>
