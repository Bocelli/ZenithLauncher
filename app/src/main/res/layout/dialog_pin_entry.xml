<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_pin_root"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pill_bg_normal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="🔒 Inserisci PIN" />

    <TextView
        android:id="@+id/tv_pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:text="Applicazione protetta" />

    <!-- 4 PIN Dots -->
    <TextView
        android:id="@+id/tv_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/accent"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.4"
        android:text="○  ○  ○  ○" />

    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#FF4D4D"
        android:textSize="12sp"
        android:text="PIN non corretto, riprova"
        android:visibility="invisible" />

    <!-- Numpad Row 1: 1, 2, 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusRight="@+id/btn_key_2"
            android:nextFocusDown="@+id/btn_key_4" />

        <TextView
            android:id="@+id/btn_key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusLeft="@+id/btn_key_1"
            android:nextFocusRight="@+id/btn_key_3"
            android:nextFocusDown="@+id/btn_key_5" />

        <TextView
            android:id="@+id/btn_key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusLeft="@+id/btn_key_2"
            android:nextFocusDown="@+id/btn_key_6" />

    </LinearLayout>

    <!-- Numpad Row 2: 4, 5, 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_1"
            android:nextFocusRight="@+id/btn_key_5"
            android:nextFocusDown="@+id/btn_key_7" />

        <TextView
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_2"
            android:nextFocusLeft="@+id/btn_key_4"
            android:nextFocusRight="@+id/btn_key_6"
            android:nextFocusDown="@+id/btn_key_8" />

        <TextView
            android:id="@+id/btn_key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_3"
            android:nextFocusLeft="@+id/btn_key_5"
            android:nextFocusDown="@+id/btn_key_9" />

    </LinearLayout>

    <!-- Numpad Row 3: 7, 8, 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_4"
            android:nextFocusRight="@+id/btn_key_8"
            android:nextFocusDown="@+id/btn_key_del" />

        <TextView
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_5"
            android:nextFocusLeft="@+id/btn_key_7"
            android:nextFocusRight="@+id/btn_key_9"
            android:nextFocusDown="@+id/btn_key_0" />

        <TextView
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_6"
            android:nextFocusLeft="@+id/btn_key_8"
            android:nextFocusDown="@+id/btn_key_cancel" />

    </LinearLayout>

    <!-- Numpad Row 4: Del, 0, Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⌫"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_7"
            android:nextFocusRight="@+id/btn_key_0" />

        <TextView
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btn_key_8"
            android:nextFocusLeft="@+id/btn_key_del"
            android:nextFocusRight="@+id/btn_key_cancel" />

        <TextView
            android:id="@+id/btn_key_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="Annulla"
            android:textColor="#B0A0D0"
            android:textSize="12sp"
            android:nextFocusUp="@+id/btn_key_9"
            android:nextFocusLeft="@+id/btn_key_0" />

    </LinearLayout>

</LinearLayout>
