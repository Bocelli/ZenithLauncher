<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 4K Wallpaper Background -->
    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_default" />

    <!-- Subtle Vignette Scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <!-- Main Vertical Layout: Top Bar + Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Persistent Top Bar: Left (Time, Settings, WiFi), Center (Segmented Capsule) -->
        <FrameLayout
            android:id="@+id/top_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="28dp"
            android:paddingBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Left: Digital Clock + Settings & Wi-Fi Icons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextClock
                    android:id="@+id/tc_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm" />

                <!-- Settings icon (sliders) -->
                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/top_button_selector"
                    android:src="@drawable/ic_tune"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/settings"
                    android:focusable="true"
                    android:clickable="true" />

                <!-- Wi-Fi icon -->
                <ImageButton
                    android:id="@+id/btn_wifi"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/top_button_selector"
                    android:src="@drawable/ic_wifi"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/wifi"
                    android:focusable="true"
                    android:clickable="true" />

            </LinearLayout>

            <!-- Center: Segmented Navigation Capsule [ Home ] [ App ] with animated sliding indicator -->
            <FrameLayout
                android:id="@+id/fl_segmented_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:background="@drawable/bg_segmented_container"
                android:defaultFocusHighlightEnabled="false"
                android:padding="4dp">

                <!-- Sliding indicator pill that moves smoothly behind the active tab -->
                <View
                    android:id="@+id/v_tab_indicator"
                    android:layout_width="85dp"
                    android:layout_height="32dp"
                    android:background="@drawable/tab_active_bg" />

                <LinearLayout
                    android:id="@+id/ll_tabs_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tab_home"
                        android:layout_width="85dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Home"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FF0E121E"
                        android:background="@null"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:clickable="true" />

                    <TextView
                        android:id="@+id/tab_app"
                        android:layout_width="85dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="App"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#B0FFFFFF"
                        android:background="@null"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:clickable="true" />

                </LinearLayout>

            </FrameLayout>

        </FrameLayout>

        <!-- Dynamic Content Area: TAB 1 (Home) or TAB 2 (App) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- TAB 1: Home Dashboard Screen -->
            <LinearLayout
                android:id="@+id/ll_home_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Greeting, Date & Weather Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_date_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:text="MARTEDÌ 3 NOVEMBRE" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:text="Buon pomeriggio." />

                    <TextView
                        android:id="@+id/tv_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="#D5FFFFFF"
                        android:textSize="14sp"
                        android:text="☁️ Rilevamento meteo in corso..." />

                </LinearLayout>

                <!-- Section 1: Preferiti (Horizontal Cards) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="48dp"
                        android:layout_marginBottom="12dp"
                        android:text="Preferiti"
                        android:textColor="#E0FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/hsv_favorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:fadingEdge="none"
                        android:requiresFadingEdge="none"
                        android:overScrollMode="never"
                        android:paddingStart="48dp"
                        android:paddingEnd="48dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/ll_favorites_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false" />

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- Section 2: Ingressi (Exactly 3 HDMI TV Inputs) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="48dp"
                        android:layout_marginBottom="12dp"
                        android:text="Ingressi"
                        android:textColor="#E0FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/hsv_inputs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:fadingEdge="none"
                        android:requiresFadingEdge="none"
                        android:overScrollMode="never"
                        android:paddingStart="48dp"
                        android:paddingEnd="48dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/ll_inputs_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false" />

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

            <!-- TAB 2: App Screen (Same screen page, NOT an overlay!) -->
            <LinearLayout
                android:id="@+id/fl_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Header / Hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applicazioni"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"
                    android:text="Premi OK per aprire  •  Tieni premuto OK o Menu (☰) per Preferiti e Blocco PIN"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <!-- GridView of all apps -->
                <GridView
                    android:id="@+id/gv_all_apps"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:numColumns="6"
                    android:verticalSpacing="18dp"
                    android:horizontalSpacing="18dp"
                    android:stretchMode="columnWidth"
                    android:gravity="center"
                    android:listSelector="@android:color/transparent"
                    android:defaultFocusHighlightEnabled="false"
                    android:scrollbars="none"
                    android:paddingBottom="48dp"
                    android:clipToPadding="false" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Overlay: PIN Prompt Dialog -->
    <FrameLayout
        android:id="@+id/fl_pin_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/dialog_pin_entry" />

    </FrameLayout>

    <!-- Overlay: App Options Menu Dialog -->
    <FrameLayout
        android:id="@+id/fl_options_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/dialog_app_options" />

    </FrameLayout>

    <!-- Overlay: Zenith Settings Modal -->
    <FrameLayout
        android:id="@+id/fl_settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/dialog_settings" />

    </FrameLayout>

    <!-- Overlay: Rename Input Dialog -->
    <FrameLayout
        android:id="@+id/fl_rename_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/dialog_rename_input" />

    </FrameLayout>

</FrameLayout>
